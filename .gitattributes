# Normalize line endings across systems so builds are identical on
# Windows, macOS, and Linux (and Jekyll front matter parses reliably).
* text=auto eol=lf

# Windows-specific scripts keep CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Treat these as binary (never touch their bytes).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.pdf  binary
*.docx binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
