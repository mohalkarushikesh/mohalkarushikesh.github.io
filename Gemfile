source "https://rubygems.org"

# Matches the GitHub Pages build environment, so `bundle exec jekyll serve`
# locally behaves the same as production.
gem "github-pages", group: :jekyll_plugins

# Plugins used by the site (also whitelisted on GitHub Pages).
group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Required for local `jekyll serve` on Ruby 3+.
gem "webrick", "~> 1.8"
